# ─── NEAR RPC ──────────────────────────────────────────────────────────────────
# Testnet is the default target for local development.
NEAR_NETWORK=testnet
NEAR_NODE_URL=https://rpc.testnet.fastnear.com
NEAR_WALLET_URL=https://testnet.mynearwallet.com

# ─── Accounts ──────────────────────────────────────────────────────────────────
# Deployer / admin account (must have a full-access key on this machine).
NEAR_ADMIN_ACCOUNT_ID=YOUR_ADMIN.testnet

# Contract account for the Roda protocol contract (create with `near create-account`).
NEAR_RODA_ACCOUNT_ID=roda.YOUR_ADMIN.testnet

# Contract account for the NEP-141 test token (optional separate account).
NEAR_TOKEN_ACCOUNT_ID=roda-usdc.YOUR_ADMIN.testnet

# Sputnik DAO v2 factory for Community Coordination Layer.
SPUTNIK_FACTORY_ID=sputnikv2.testnet

# Optional private key for automated deploys/scripts (ed25519:...)
NEAR_PRIVATE_KEY=


# ─── Token configuration ───────────────────────────────────────────────────────
# Decimals for the test FT (USDC-style = 6).
NEAR_TOKEN_DECIMALS=6

# ─── Contract init args (used by scripts/setup-testnet.js) ─────────────────────
# Path to built wasm artifacts (relative to program/).
NEAR_RODA_WASM=target/wasm32-unknown-unknown/release/roda.wasm
NEAR_TOKEN_WASM=target/wasm32-unknown-unknown/release/roda_token.wasm

# Faucet enabled on the Roda contract (true for test token, false for mainnet USDC).
NEAR_FAUCET_ENABLED=true
