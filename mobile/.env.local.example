# Copy to .env.local and fill in. Never commit the real .env.local.
# Env files are gitignored (root .gitignore: .env, .env.*).

# Public Expo values are bundled into the app. Never put private keys here.
EXPO_PUBLIC_NEAR_NETWORK=testnet
EXPO_PUBLIC_NEAR_RPC_URL=https://rpc.testnet.fastnear.com
EXPO_PUBLIC_CONTRACT_ID=roda.testnet
EXPO_PUBLIC_FT_ID=roda-usdc.testnet

# Publishable key from https://dashboard.magic.link.
EXPO_PUBLIC_MAGIC_PUBLISHABLE_KEY=

# Magic secret keys and deployer keys must remain server-side.
